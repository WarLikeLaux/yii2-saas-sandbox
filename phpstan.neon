includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 9
    phpVersion: 70400
    universalObjectCratesClasses:
        - yii\base\Component
    paths:
        - commands
        - components
        - controllers
        - jobs
        - models
        - services
        - widgets
    bootstrapFiles:
        - vendor/yiisoft/yii2/Yii.php
    excludePaths:
        - runtime
        - tests
        - vendor
