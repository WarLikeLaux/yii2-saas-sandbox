# Docker: UID/GID процесса php внутри контейнера (совпадение с хостом — права на файлы)
UID=1000
GID=1000

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=yii2basic
DB_USER=yii2
DB_PASSWORD=secret

# Redis (кэш Yii)
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ (брокер yii2-queue, драйвер amqp_interop)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Секрет подписи cookie (обязательно задать в production)
COOKIE_VALIDATION_KEY=
