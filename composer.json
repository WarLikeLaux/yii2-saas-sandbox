{
    "name": "warlikelaux/yii2-saas-sandbox",
    "description": "Песочница для прототипов SaaS-бэкенда: PHP 7.4 + Yii2 в Docker с PostgreSQL, Redis и RabbitMQ",
    "keywords": ["yii2", "saas", "sandbox", "docker", "postgresql", "redis", "rabbitmq"],
    "homepage": "https://github.com/WarLikeLaux/yii2-saas-sandbox",
    "type": "project",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/WarLikeLaux/yii2-saas-sandbox/issues",
        "source": "https://github.com/WarLikeLaux/yii2-saas-sandbox"
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.4.0",
        "yiisoft/yii2": "~2.0.45",
        "yiisoft/yii2-bootstrap5": "~2.0.2",
        "yiisoft/yii2-symfonymailer": "~2.0.3",
        "yiisoft/yii2-redis": "~2.0.18",
        "yiisoft/yii2-queue": "^2.3",
        "enqueue/amqp-lib": "0.10.19",
        "enqueue/amqp-tools": "0.10.19",
        "enqueue/dsn": "0.10.19",
        "twbs/bootstrap-icons": "1.11.3"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-gii": "~2.2.0",
        "yiisoft/yii2-faker": "~2.0.0",
        "codeception/codeception": "^5.0.0 || ^4.0",
        "codeception/lib-innerbrowser": "^4.0 || ^3.0 || ^1.1",
        "codeception/module-asserts": "^3.0 || ^1.1",
        "codeception/module-yii2": "^1.1",
        "codeception/module-filesystem": "^3.0 || ^2.0 || ^1.1",
        "codeception/verify": "^3.0 || ^2.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.4",
        "phpstan/phpstan-strict-rules": "^2.0",
        "roave/security-advisories": "dev-latest"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer" : true
        },
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        }
    },
    "scripts": {
        "post-install-cmd": [
            "yii\\composer\\Installer::postInstall"
        ],
        "post-create-project-cmd": [
            "yii\\composer\\Installer::postCreateProject",
            "yii\\composer\\Installer::postInstall"
        ]
    },
    "extra": {
        "yii\\composer\\Installer::postCreateProject": {
            "setPermission": [
                {
                    "runtime": "0777",
                    "web/assets": "0777",
                    "yii": "0755"
                }
            ]
        },
        "yii\\composer\\Installer::postInstall": {
            "generateCookieValidationKey": [
                "config/web.php"
            ]
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
